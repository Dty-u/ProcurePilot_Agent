# Application
APP_ENV=development
LOG_LEVEL=INFO

# OpenAI-compatible model
MODEL_NAME=your-model-name
MODEL_BASE_URL=https://your-model-provider.example/v1
MODEL_API_KEY=replace-with-your-api-key

# Procurement business database
MYSQL_DSN=mysql+aiomysql://procurepilot:replace-with-password@127.0.0.1/procurepilot_dev
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10
MYSQL_POOL_TIMEOUT_SECONDS=30
MYSQL_CONNECT_TIMEOUT_SECONDS=10

# Agent checkpoint database (must be separate from the business database)
AGENT_CHECKPOINT_MYSQL_DSN=mysql+aiomysql://procurepilot_checkpoint:replace-with-password@127.0.0.1/procurepilot_checkpoint_dev
# Enable only for an explicitly authorized first-time setup or package migration
AGENT_CHECKPOINT_AUTO_SETUP=false

# MCP and OpenSandbox
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8001
FASTAPI_PORT=18000
OPENSANDBOX_BASE_URL=http://127.0.0.1:8080
OPENSANDBOX_API_KEY=replace-with-your-sandbox-key
# Must be pinned to an immutable digest; replace with your audited image.
OPENSANDBOX_IMAGE=registry.example/procurepilot-sandbox@sha256:replace-with-64-hex-digest
OPENSANDBOX_CPU=500m
OPENSANDBOX_MEMORY=512Mi
OPENSANDBOX_DISK=1Gi
OPENSANDBOX_MAX_FILE_BYTES=10000000
OPENSANDBOX_MAX_PROCESSES=32
OPENSANDBOX_TTL_SECONDS=600
OPENSANDBOX_READY_TIMEOUT_SECONDS=30

# Runtime limits
REQUEST_TIMEOUT_SECONDS=30
MODEL_CALL_LIMIT=50
TOOL_CALL_LIMIT=200
